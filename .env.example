# ==============================================================================
# DRAFT & RISE · Variáveis de Ambiente (Produção & Local)
# Copia este ficheiro para .env.local para testes locais ou adiciona no painel da Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL Oficial da Aplicação
# ------------------------------------------------------------------------------
PORTAL_APP_URL=https://draftandrise.com

# ------------------------------------------------------------------------------
# 2. Notificações por E-mail (Resend API)
# Para receber códigos de 6 dígitos e alertas de fichas em geral@draftandrise.com
# Cria uma conta gratuita em https://resend.com e obtém a tua API Key
# ------------------------------------------------------------------------------
PORTAL_NOTIFICATION_EMAIL=geral@draftandrise.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Draft & Rise <notificacoes@draftandrise.com>

# ------------------------------------------------------------------------------
# 3. Base de Dados na Cloud (Supabase PostgreSQL para Vercel)
# Executa o script documents/SUPABASE-SETUP.sql no SQL Editor do Supabase
# ------------------------------------------------------------------------------
PORTAL_REMOTE_ENABLED=1
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# EXCLUSIVAMENTE SERVIDOR (NUNCA expor no frontend nem usar prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 4. Palavras-Passe da Equipa (Opcional - Substitui as passwords padrão)
# Se não preencheres, o sistema utiliza as passwords seguras padrão dos PDFs
# ------------------------------------------------------------------------------
PORTAL_TEAM_USER1_PASS=DR-User1-8492
PORTAL_TEAM_USER2_PASS=DR-User2-3917
PORTAL_TEAM_USER3_PASS=DR-User3-6520
PORTAL_TEAM_USER4_PASS=DR-User4-9148
PORTAL_TEAM_USER5_PASS=DR-User5-2763
PORTAL_TEAM_USER6_PASS=DR-User6-5084

# ------------------------------------------------------------------------------
# 5. Modo de Desenvolvimento Local (SQLite Offline)
# No teu computador podes usar PORTAL_LOCAL_MODE=1 para testar tudo sem internet.
# Na Vercel, este valor deve ser 0 (ou omitido).
# ------------------------------------------------------------------------------
PORTAL_LOCAL_MODE=0
