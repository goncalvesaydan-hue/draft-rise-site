# Copiar para .env.local; nunca versionar valores reais.
# A demonstração arranca com npm run dev:portal e aceita apenas loopback.
# Não ativar modo local no alojamento público.
PORTAL_LOCAL_MODE=0
PORTAL_REMOTE_ENABLED=0
PORTAL_AUTH_EMAILS_ENABLED=0
PORTAL_APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exclusivamente servidor. NUNCA usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
